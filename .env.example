# Password-reset email settings. Fill these with your mail provider's SMTP credentials.
# Use the provider's SMTP/app password, not a user's website password.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="Dr. Teeth <noreply@your-domain.com>"
PASSWORD_RESET_TIMEOUT=3600

# Include your real website domain in production. Restart Django after changes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# For local testing without sending email, use this backend instead:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
